<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
    <queries>
        <intent><action android:name="android.service.euicc.EuiccService"/></intent>
        <intent><action android:name="android.telephony.euicc.action.MANAGE_EMBEDDED_SUBSCRIPTIONS"/></intent>
        <package android:name="me.weishu.kernelsu"/>
        <package android:name="com.rifsxd.ksunext"/>
        <package android:name="com.sukisu.ultra"/>
        <package android:name="com.sukisu.nova"/>
        <package android:name="me.bmax.apatch"/>
        <package android:name="com.android.phone"/>
        <package android:name="com.miui.euicc"/>
        <provider android:authorities="service-state;com.miui.euicc.provider"/>
        <!-- Device status page: checks which apps handle standard activation and LPA: links -->
        <intent><action android:name="android.telephony.euicc.action.START_EUICC_ACTIVATION"/></intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="lpa"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="LPA"/>
        </intent>
    </queries>
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:description="@string/xposed_description"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.EsimH4">
        <service
            android:name="io.github.local.esimh4probe.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths"/>
        </provider>
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description"/>
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope"/>
        <activity
            android:name="io.github.local.esimh4probe.MainActivity"
            android:theme="@style/Theme.EsimH4.Launch"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name="io.github.local.esimh4probe.AboutActivity"
            android:exported="false"/>
        <activity
            android:name="io.github.local.esimh4probe.LicensesActivity"
            android:exported="false"/>
        <activity
            android:name="io.github.local.esimh4probe.DeviceStatusActivity"
            android:exported="false"/>
        <activity
            android:name="io.github.local.esimh4probe.LpaBridgeActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.telephony.euicc.action.START_EUICC_ACTIVATION"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="lpa"/>
                <data android:scheme="LPA"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
